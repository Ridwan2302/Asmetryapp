{
  "expo": {
    "name": "Asmetry",
    "slug": "asmetry",
    "scheme": "asmetry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.asmetry.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Asmetry uses your camera to scan your face for the facial analysis.",
        "NSPhotoLibraryUsageDescription": "Asmetry needs photo access so you can upload a scan photo or a profile picture."
      }
    },
    "android": {
      "package": "io.asmetry.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4F2ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Asmetry uses your camera to scan your face for the facial analysis.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Asmetry needs photo access so you can upload a scan photo or a profile picture.",
          "cameraPermission": "Asmetry uses your camera to scan your face for the facial analysis.",
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
